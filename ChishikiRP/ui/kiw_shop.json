        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not (#item_text = '')) and (((#item_text - '§s§h§s§l') = #item_text) and ((#item_text - '§s§h§s§r') = #item_text)))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_text = '') or ((not ((#item_text - '§s§h§s§l') = #item_text)) or (not ((#item_text - '§s§h§s§r') = #item_text))))",
        "target_property_name": "#ignored"
