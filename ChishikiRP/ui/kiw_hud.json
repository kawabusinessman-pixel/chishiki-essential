{
  "namespace": "kiw_hud",

  "item_text_label": {
    "type": "panel",
    "size": [ "100%c", "100%c" ],
    "max_size": "$size",
    "$size": [ "100%c", "100%c" ],
    "clips_children": true,
    "controls": [
      {
        "text": {
          "type": "label",
          "size": [ "default", "default" ],
          "text_alignment": "center",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 31,
          "shadow": true,
          "color": "$text_color",
          "text": "#text",
          "alpha": "@kiw_hud.anim_item_name_text_alpha_in",
          "bindings": [
            {
              "binding_name": "$text_binding",
              "binding_name_override": "#text"
            }
          ]
        }
      }
    ]
  },

  "anim_item_name_text_alpha_in": {
    "anim_type": "alpha",
    "duration": 0.2,
    "from": 0.0,
    "to": 1.0,
    "next": "@kiw_hud.anim_item_name_text_alpha_stay"
  },
  "anim_item_name_text_alpha_stay": {
    "anim_type": "wait",
    "duration": 1,
    "next": "@kiw_hud.anim_item_name_text_alpha_out"
  },
  "anim_item_name_text_alpha_out": {
    "anim_type": "alpha",
    "destroy_at_end": "$destroy_id",
    "duration": 0.4,
    "from": 1.0,
    "to": 0
  },

  "anim_item_name_background_alpha_in": {
    "anim_type": "alpha",
    "duration": 0.2,
    "from": 0,
    "to": "$item_text_background_alpha",
    "next": "@kiw_hud.anim_item_name_background_alpha_stay"
  },
  "anim_item_name_background_alpha_stay": {
    "anim_type": "wait",
    "duration": 1,
    "next": "@kiw_hud.anim_item_name_background_alpha_out"
  },
  "anim_item_name_background_alpha_out": {
    "anim_type": "alpha",
    "duration": 0.4,
    "from": "$item_text_background_alpha",
    "to": 0
  }
}
